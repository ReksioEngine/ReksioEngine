{
    "compilerOptions": {
        "target": "es2021",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": [
        "tests/**/*",
        "src/**/*",
        ".eslintrc.js",
        "jest.config.js",
        "webpack.config.tests.ts"
    ]
}