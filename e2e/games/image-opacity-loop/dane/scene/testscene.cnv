OBJECT=CANVAS_OBSERVER
CANVAS_OBSERVER:TYPE=CANVAS_OBSERVER

OBJECT=TEST_IMAGE
TEST_IMAGE:TYPE=IMAGE
TEST_IMAGE:FILENAME=COLORS.IMG
TEST_IMAGE:VISIBLE=TRUE
TEST_IMAGE:TOCANVAS=TRUE

OBJECT=TICKNO
TICKNO:TYPE=INTEGER
TICKNO:VALUE=0
TICKNO:ONCHANGED^256={TESTAPP^EXIT();}

OBJECT=TIMSAVE
TIMSAVE:TYPE=TIMER
TIMSAVE:ELAPSE=10
TIMSAVE:TICKS=256
TIMSAVE:ONTICK={TEST_IMAGE^SETOPACITY(TICKNO); CANVAS_OBSERVER^REDRAW(); CANVAS_OBSERVER^SAVE([["..\..\OUTPUT\OUT" + TICKNO] + ".IMG"], 1, 1); TICKNO^INC();}
